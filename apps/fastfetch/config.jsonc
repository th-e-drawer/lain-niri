{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
        "type": "auto",
		"source": "~/.config/fastfetch/ascii/lain-grin.txt",
		"padding": {
			"top": 1,
			"left": 3,
			"right": 2
		},
		"color": {
			"1": "yellow"
		}
	},
	"display": {
		"separator": "  "
	},
	"modules": [
        {
            "type": "custom",
            "format": "{#@160}          ╔══════════════════════════════════════╗"
        },
        {
            "type": "custom",
            "format": "{#@160}          ║ {#@217}   ███╗   ██╗ █████╗ ██╗   ██╗██╗    {#@160}║"
        },
        {
            "type": "custom",
            "format": "{#@160}          ║ {#@217}   ████╗  ██║██╔══██╗██║   ██║██║    {#@160}║"
        },
        {
            "type": "custom",
            "format": "{#@160}          ║ {#@217}   ██╔██╗ ██║███████║██║   ██║██║    {#@160}║"
        },
        {
            "type": "custom",
            "format": "{#@160}          ║ {#@217}   ██║╚██╗██║██╔══██║╚██╗ ██╔╝██║    {#@160}║"
        },
        {
            "type": "custom",
            "format": "{#@160}          ║ {#@217}   ██║ ╚████║██║  ██║ ╚████╔╝ ██║    {#@160}║"
        },
        {
            "type": "custom",
            "format": "{#@160}          ║ {#@217}   ╚═╝  ╚═══╝╚═╝  ╚═╝  ╚═══╝  ╚═╝    {#@160}║"
        },
        {
            "type": "custom",
            "format": "{#@160}          ╚══════════════════════════════════════╝"
        },
		"break",
		{
            "type": "custom",
            "format": "{#@203}┌────────────────────────────────────────────────────────┐"
        },
		{
			"type": "host",
			"key": " PC",
			"keyColor": "yellow"
		},

		{
			"type": "cpu",
			"key": "│ ├󰍛 ",
			"keyColor": "yellow"
		},
		{
			"type": "gpu",
			"key": "│ ├󰘚",
			"keyColor": "yellow"
		},
		{
			"type": "display",
			"key": "│ ├󰍹",
			"keyColor": "yellow"
		},
		{
            "type": "custom",
            "format": "{#@203}└────────────────────────────────────────────────────────┘"
        },
		"break",
		{
            "type": "custom",
            "format": "{#@203}┌────────────────────────────────────────────────────────┐"
        },
		{
			"type": "locale",
			"key": "󰊠 SYS",
			"keyColor": "yellow"
		},
		{
			"type": "uptime",
			"key": "│ ├󰅐",
			"keyColor": "yellow"
		},
		{
			"type": "disk",
			"key": "│ ├",
			"keyColor": "yellow",
			"percent": {
				"green": 60,
				"yellow": 85
			}
		},
		{
			"type": "memory",
			"key": "│ ├",
			"keyColor": "yellow",
			"percent": {
				"green": 40,
				"yellow": 80
			}
		},
		{
            "type": "custom",
            "format": "{#@203}└────────────────────────────────────────────────────────┘"
        },
		"break",
		{
            "type": "custom",
            "format": "{#@203}┌────────────────────────────────────────────────────────┐"
        },

		{
			"type": "os",
			"key": " OS",
			"keyColor": "yellow"
		},
		{
			"type": "kernel",
			"key": "│ ├",
			"keyColor": "yellow"
		},
		{
			"type": "shell",
			"key": "│ ├",
			"keyColor": "yellow"
		},
		{
			"type": "packages",
			"key": "│ ├󰏗",
			"keyColor": "yellow"
		},
		{
			"type": "de",
			"key": "│ ├",
			"keyColor": "yellow"
		},
		{
			"type": "wm",
			"key": "│ ├",
			"keyColor": "yellow"
		},
		{
    		"type": "command",
     		"key": "│ ├",
			"text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
			"format": "{result}",
			"keyColor": "yellow"
    	},
		{
            "type": "custom",
            "format": "{#@203}└────────────────────────────────────────────────────────┘"
        },
		"break",
		{
            "type": "custom",
            "format": "{#@160}             ╔═══════════════════════════════╗"
        },
		{
            "type": "custom",
            "format": "{#@160}             ║ {#@217}    “let's all love lain”     {#@160}║"
        },
		{
            "type": "custom",
            "format": "{#@160}             ╚═══════════════════════════════╝"
        }
	]
}
